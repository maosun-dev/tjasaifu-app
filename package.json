    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capgo/native-purchases": "8.9.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
