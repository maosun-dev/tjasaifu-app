{
  "name": "tjasaifu-app",
  "version": "0.1.0",
  "private": true,
  "description": "TJA採譜台 の iPhone アプリ（いまのツールを Capacitor で包む）",
  "type": "module",
  "scripts": {
    "pull-web": "node tools/pull-web.mjs",
    "build": "node tools/build-www.mjs",
